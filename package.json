{
  "name": "kody-celld",
  "version": "0.1.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "description": "Self-hosted Kody core (MCP search/execute, packages, secrets, jobs) running on Deno celld.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "celld dev . --port 8787",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint src smoke examples scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test 'src/**/*.test.ts'",
    "smoke": "node smoke/run.mjs",
    "smoke:cron": "node smoke/run.mjs --wait-cron",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "fleet:render": "node scripts/render-fleet-config.mjs",
    "fleet:deploy": "npm run fleet:render && celld deploy wrangler.fleet.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/node": "24.13.4",
    "esbuild": "^0.25.12",
    "oxlint": "1.81.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
