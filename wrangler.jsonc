// Local development configuration for `celld dev .`
// Fleet deployments render wrangler.fleet.jsonc (git-ignored) from this file via
// `npm run fleet:render` so operator values never live in git. See docs/run-fleet.md.
//
// Loopback smoke defaults (email, private-host allowances, …) live in
// `.dev.vars.example` and are copied to `.dev.vars` by `npm run dev`. They must
// not appear here: single-node Docker runs `celld dev`, which would otherwise
// inherit them when the operator leaves those env vars unset.
{
  "name": "kody-celld",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat", "sqlite_vec"],
  "worker_loaders": [{ "binding": "LOADER" }],
  // Static web UI assets (stylesheet, fonts, icons, and the Vite-built browser
  // bundle in public/build — run `npm run build:client` first). Served by celld's
  // asset layer before the Worker; requests with no matching file fall through
  // to src/index.ts, so the Worker still owns every route it did before.
  "assets": { "directory": "./public", "run_worker_first": false },
  // R2-compatible bucket binding. celld stores objects under r2/<bucket_name>/ in
  // the fleet bucket (or .celld/dev locally). Optional: KODY_BLOB_PROVIDER=s3
  // talks to any S3-compatible bucket directly instead (docs/blobs.md).
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "kody-blobs" }],
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY", "class_name": "RegistryCell" },
      { "name": "USER", "class_name": "UserCell" },
      { "name": "MEMORY", "class_name": "MemoryCell" },
      { "name": "PACKAGE_STORAGE", "class_name": "PackageStorageCell" },
      { "name": "NPM_CACHE", "class_name": "NpmCacheCell" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RegistryCell", "UserCell", "PackageStorageCell"],
    },
    { "tag": "v2", "new_sqlite_classes": ["MemoryCell"] },
    { "tag": "v3", "new_sqlite_classes": ["NpmCacheCell"] },
  ],
  "vars": {
    // Loopback-only operator placeholders for `celld dev`. They are not secrets.
    // The Worker refuses non-loopback requests while these are in effect.
    // Fleet values come from KODY_ADMIN_TOKEN / KODY_MASTER_KEY env at render time.
    // Single-node Docker always overrides them via .dev.vars from /data/kody.env.
    "KODY_ADMIN_TOKEN": "dev-admin-token",
    "KODY_MASTER_KEY": "dev-master-key-only-for-celld-dev",
    "KODY_PUBLIC_URL": "http://127.0.0.1:8787",
  },
}
