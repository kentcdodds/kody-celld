# Copy to .env. Never commit .env. Values here are examples, not secrets.

# ---- Single node (compose.yaml) ---------------------------------------------
# The URL people (and their MCP clients) will use to reach this Kody.
KODY_PUBLIC_URL=http://localhost:8080
# Host port to publish.
KODY_PORT=8080
# Leave empty to let the container generate and persist both in /data/kody.env.
KODY_ADMIN_TOKEN=
KODY_MASTER_KEY=
# Master-key rotation: retired key(s), comma-separated, kept only until
# `POST /admin/secrets/rekey` reports remaining=0 (see docs/secrets.md).
KODY_MASTER_KEY_PREVIOUS=

# ---- Limits and quotas (both modes; see docs/operations.md) ------------------
# Empty = built-in default. Quotas: 0 = unlimited; admins can override per user
# with PUT /admin/users/<id>/quota.
# KODY_EXECUTE_TIMEOUT_MS=60000          # 1000..900000
# KODY_RUN_RETENTION_COUNT=500           # newest runs kept per user
# KODY_RUN_RETENTION_DAYS=0              # also drop runs older than N days (0 = off)
# KODY_RUN_LOG_LIMIT=200                 # console entries stored per run
# KODY_RESPONSE_LIMIT_BYTES=100000       # default execute result cap
# KODY_AUDIT_RETENTION_COUNT=10000       # admin audit entries kept
# KODY_MCP_CONTENT_LIMIT_BYTES=512000    # cap for __mcpContent (images/audio) from execute
# KODY_QUOTA_RUNS_PER_DAY=0
# KODY_QUOTA_EXECUTE_MS_PER_DAY=0
# KODY_QUOTA_PACKAGES=0
# KODY_QUOTA_SECRETS=0
# KODY_QUOTA_JOBS=0
# KODY_QUOTA_BLOBS=0                     # stored objects per user
# KODY_QUOTA_BLOB_BYTES=0                # stored bytes per user

# ---- Blob storage (both modes; see docs/blobs.md) ----------------------------
# Default (empty / r2): celld's R2-compatible binding stores objects in the same
# place as everything else (the fleet bucket, or the kody-data volume on a
# single node). Nothing to configure. Set s3 to use a separate S3-compatible
# bucket directly (AWS S3, Cloudflare R2, MinIO, Backblaze B2, Garage, ...).
# KODY_BLOB_PROVIDER=r2                   # r2 | s3
# KODY_BLOB_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com   # or https://<accountid>.r2.cloudflarestorage.com, http://minio:9000
# KODY_BLOB_S3_BUCKET=kody-blobs
# KODY_BLOB_S3_REGION=auto
# KODY_BLOB_S3_ACCESS_KEY_ID=
# KODY_BLOB_S3_SECRET_ACCESS_KEY=
# KODY_BLOB_S3_PREFIX=                    # optional key prefix inside the bucket
# KODY_BLOB_S3_FORCE_PATH_STYLE=1         # MinIO/Garage need path-style; AWS/R2 work either way
# KODY_BLOB_MAX_BYTES=26214400            # per object (25 MB)
# KODY_BLOB_URL_TTL_SECONDS=3600          # default lifetime of blobUrl links (max 7 days)

# ---- npm imports + package installs (see docs/packages.md) -------------------
# Bare `import x from 'pkg@1.2.3'` inside execute/packages is resolved through an
# esm.sh-compatible CDN and kept in a fleet-wide durable cache. Self-host the CDN
# with compose.esm.yaml (then KODY_ESM_CDN_URL=http://esm) or point at your own.
# KODY_NPM_IMPORTS=on                     # on | off
# KODY_ESM_CDN_URL=https://esm.sh
# KODY_NPM_CACHE_MAX_MB=256               # 0 disables the durable cache
# KODY_NPM_CACHE_TTL_DAYS=30
# Hosts packageInstall may download package sources from (tar.gz / JSON file
# maps / github:owner/repo). Default: github.com + codeload/raw/gist hosts.
# KODY_PACKAGE_SOURCE_HOSTS=github.com,codeload.github.com,raw.githubusercontent.com,gist.githubusercontent.com
# Self-hosted esm CDN beside the single node:
# COMPOSE_FILE=compose.yaml:compose.esm.yaml

# ---- Browser rendering (both modes; see docs/browser.md) ---------------------
# Off unless configured. Self-hosted: add compose.browser.yaml (browserless
# container). External: KODY_BROWSER_PROVIDER=cloudflare with an API token.
# KODY_BROWSER_PROVIDER=none              # none | browserless | cloudflare
# KODY_BROWSER_URL=http://browserless:3000
# KODY_BROWSER_TOKEN=                     # browserless TOKEN or Cloudflare API token
# KODY_BROWSER_CF_ACCOUNT_ID=             # cloudflare only
# KODY_BROWSER_TIMEOUT_MS=30000
# Comma-separated hosts the browser may render even though they are private/loopback
# (e.g. a dashboard on your LAN). Everything else private is refused (SSRF guard).
# KODY_BROWSER_ALLOW_PRIVATE_HOSTS=
# Self-hosted browser beside the single node:
# COMPOSE_FILE=compose.yaml:compose.browser.yaml

# ---- Email + webhooks (both modes; see docs/email.md, docs/webhooks.md) ------
# Package webhooks (POST /webhooks/...) need nothing here. Email is off until
# KODY_EMAIL_DOMAIN is set; every user then gets <local>@<domain> inboxes.
# KODY_EMAIL_DOMAIN=kody.example.com
# Shared token your inbound provider / mail bridge presents at POST /email/inbound/<provider>
# (Bearer, Basic password, ?token= or x-kody-email-token). Generate: openssl rand -hex 32
# KODY_EMAIL_INBOUND_TOKEN=
# KODY_EMAIL_MAILGUN_SIGNING_KEY=         # mailgun inbound only: HTTP webhook signing key
# Outbound: none | bridge (SMTP via compose.mail.yaml) | resend | postmark | mailgun | sendgrid
# KODY_EMAIL_OUTBOUND_PROVIDER=none
# KODY_EMAIL_OUTBOUND_URL=                # bridge: http://mail-bridge:8025 ; others: default API URL
# KODY_EMAIL_OUTBOUND_TOKEN=              # provider API key, or the bridge's MAIL_BRIDGE_TOKEN
# KODY_EMAIL_MAILGUN_DOMAIN=              # mailgun outbound only; defaults to KODY_EMAIL_DOMAIN
# KODY_EMAIL_FROM_NAME=Kody
# KODY_EMAIL_TIMEOUT_MS=15000
# KODY_EMAIL_MAX_BYTES=10485760           # stored size per message incl. attachments (10 MB)
# KODY_WEBHOOK_MAX_BODY_BYTES=1048576     # inbound webhook body limit (1 MB)
# KODY_QUOTA_EMAIL_MESSAGES=0             # stored messages per user; 0 = unlimited
# KODY_QUOTA_EMAIL_SENDS_PER_DAY=0        # 0 = unlimited
# KODY_QUOTA_EMAIL_RECEIVES_PER_DAY=0     # 0 = unlimited
# Self-hosted SMTP bridge (receives mail on port 25, sends via your SMTP relay):
# COMPOSE_FILE=compose.yaml:compose.mail.yaml
# MAIL_BRIDGE_TOKEN=                      # shared with KODY_EMAIL_OUTBOUND_TOKEN; openssl rand -hex 32
# MAIL_BRIDGE_SMTP_URL=smtps://user:pass@smtp.example.com:465   # relay for outbound; empty = direct MX delivery

# ---- OAuth integrations + secret providers (docs/integrations.md, docs/secret-providers.md)
# OAuth apps are configured per user from an MCP session (integrationSave); the
# redirect URI to register with each provider is ${KODY_PUBLIC_URL}/connect/oauth/callback.
# KODY_SECRET_PROVIDER_CACHE_SECONDS=300  # in-memory TTL for {{secret/...}} values; 0 disables
# KODY_SECRET_PROVIDER_TIMEOUT_MS=20000   # cap for one sealed provider run

# ---- AI, memories, semantic search (both modes; see docs/ai.md) --------------
# Everything here is optional. With nothing set, memories still work and search
# is lexical (FTS5). Any OpenAI-compatible endpoint works: Ollama, LM Studio,
# vLLM, OpenRouter, OpenAI… Chat provider: none | openai | anthropic.
# KODY_AI_PROVIDER=none
# KODY_AI_BASE_URL=http://host.docker.internal:11434/v1   # Ollama on the Docker host
# KODY_AI_API_KEY=                        # only for providers that need one
# KODY_AI_CHAT_MODEL=llama3.2
# Embeddings (OpenAI-compatible). Defaults to the chat endpoint/key when unset.
# KODY_AI_EMBED_PROVIDER=openai           # openai | none
# KODY_AI_EMBED_BASE_URL=
# KODY_AI_EMBED_API_KEY=
# KODY_AI_EMBED_MODEL=nomic-embed-text
# KODY_AI_EMBED_DIMENSIONS=768            # must match the model (1..8192)
# KODY_AI_TIMEOUT_MS=20000
# Re-rank the top search hits with the chat model: off | llm (needs a chat provider).
# KODY_SEARCH_RERANK=off
# Vector store: local (sqlite-vec inside the memory cell, default) | qdrant.
# KODY_VECTOR_PROVIDER=local
# KODY_QDRANT_URL=http://qdrant:6333
# KODY_QDRANT_API_KEY=
# KODY_QDRANT_COLLECTION=kody-memories
# Fully local stack (Ollama + Qdrant containers) for the single node:
# COMPOSE_FILE=compose.yaml:compose.ai.yaml

# ---- Fleet (compose.fleet.yaml + compose.minio.yaml) ------------------------
# Uncomment to make plain `docker compose ...` use the fleet files:
# COMPOSE_FILE=compose.fleet.yaml:compose.minio.yaml
#
# Generate both with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# KODY_ADMIN_TOKEN=<32+ random characters>
# KODY_MASTER_KEY=<32+ random characters>
# KODY_PUBLIC_URL=https://kody.example.com
# Set to 1 when KODY_PUBLIC_URL is http:// on a trusted LAN (no TLS in front).
# KODY_ALLOW_HTTP_PUBLIC_URL=0
# Caddy site address: ":80" (plain HTTP), "kody.example.com" (Let's Encrypt),
# or "https://kody.lan" (Caddy's local CA).
# KODY_SITE_ADDRESS=:80
# KODY_HTTP_PORT=80
# KODY_HTTPS_PORT=443
#
# Bucket. With compose.minio.yaml these credentials also become MinIO's root user.
# For AWS S3 / R2 / another MinIO: set S3_ENDPOINT (empty = AWS), region and keys.
# CELLD_BUCKET=s3://kody-celld
# S3_ENDPOINT=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=kody-celld
# AWS_SECRET_ACCESS_KEY=<20+ random characters>
# KODY_CREATE_BUCKET=1
